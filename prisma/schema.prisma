datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PromoCategory {
  SPORT
  CASINO
  MISSIONS
  ALL
  GOLD
  QUARTER_FINAL
  SEMI_FINAL
  FINAL
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

model Market {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  domain        String?  @unique
  locales       String[]
  defaultLocale String?
  timezone      String   @default("Europe/Belgrade")
  active        Boolean  @default(true)

  calendarSettings  CalendarSettings[]
  specialPromotions SpecialPromotion[]
  weeklyPlans       WeeklyPlan[]
  admins            AdminUser[]
}

model CalendarSettings {
  id                 Int      @id @default(autoincrement())
  marketId           String
  market             Market   @relation(fields: [marketId], references: [id])
  bgImageUrl         String?
  bgImageUrlMobile   String?
  monthBackgrounds   Json?
  calendarPosition   String?
  calendarTitle      Json?
  logoUrl            String?
  theme              String?
  seoMeta            Json?
  countdownTargetIso String?
  countdownLabel     String?
  leaderboard        Json?
  scratchCoverUrl    String?
  updatedAt          DateTime @updatedAt

  @@unique([marketId])
}

model SpecialPromotion {
  id            Int      @id @default(autoincrement())
  marketId      String
  market        Market   @relation(fields: [marketId], references: [id])
  year          Int
  month         Int
  day           Int
  title         String
  link          String
  button        String
  active        Boolean  @default(true)
  icon          String?
  buttonColor   String   @default("green")
  rich          Json?
  richHtml      String?
  scratch       Boolean  @default(false)
  flipCard      Boolean  @default(false)
  knockoutPhase String?

  translations Json?
  category     PromoCategory @default(ALL)

  @@index([marketId, year, month])
}

model WeeklyPlan {
  id          Int      @id @default(autoincrement())
  marketId    String
  market      Market   @relation(fields: [marketId], references: [id])
  year        Int
  month       Int
  weekday     Int
  title       String
  link        String
  button      String
  active      Boolean  @default(true)
  icon        String?
  rich        Json?
  richHtml    String?
  buttonColor String   @default("green")
  scratch     Boolean  @default(false)
  flipCard    Boolean  @default(false)

  translations Json?
  category     PromoCategory @default(ALL)

  @@unique([marketId, year, month, weekday])
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  marketId     String?
  market       Market?  @relation(fields: [marketId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
