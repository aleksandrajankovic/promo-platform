// URL baze je u prisma.config.ts (CLI) i u src/lib/db.js (aplikacija, preko
// driver adaptera) — Prisma 7 ga više ne čita odavde.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum PromoCategory {
  SPORT
  CASINO
  MISSIONS
  ALL
  GOLD
  QUARTER_FINAL
  SEMI_FINAL
  FINAL
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

model Market {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  domain        String?  @unique
  locales       String[]
  defaultLocale String?
  timezone      String   @default("Europe/Belgrade")
  active        Boolean  @default(true)

  calendarSettings  CalendarSettings[]
  specialPromotions SpecialPromotion[]
  weeklyPlans       WeeklyPlan[]
  admins            AdminUser[]
  auditLogs         PromoAuditLog[]
}

model CalendarSettings {
  id                 Int      @id @default(autoincrement())
  marketId           String
  market             Market   @relation(fields: [marketId], references: [id], onDelete: Restrict)
  bgImageUrl         String?
  bgImageUrlMobile   String?
  monthBackgrounds   Json?
  calendarPosition   String?
  calendarTitle      Json?
  logoUrl            String?
  theme              String?
  seoMeta            Json?
  countdownTargetIso String?
  countdownLabel     Json? // { jezik: tekst }, kao calendarTitle
  leaderboard        Json?
  scratchCoverUrl    String?
  scratchCursorUrl   String?
  updatedAt          DateTime @updatedAt

  @@unique([marketId])
}

model SpecialPromotion {
  id            Int     @id @default(autoincrement())
  marketId      String
  market        Market  @relation(fields: [marketId], references: [id], onDelete: Restrict)
  year          Int
  month         Int
  day           Int
  title         String
  link          String
  button        String
  active        Boolean @default(true)
  icon          String?
  buttonColor   String  @default("green")
  rich          Json?
  richHtml      String?
  scratch       Boolean @default(false)
  flipCard      Boolean @default(false)
  knockoutPhase String?

  translations Json?
  category     PromoCategory @default(ALL)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  // ko je kreirao / poslednji menjao (pun log izmena je u PromoAuditLog)
  createdById Int?
  createdBy   AdminUser? @relation("SpecialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById Int?
  updatedBy   AdminUser? @relation("SpecialUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([marketId, year, month])
}

model WeeklyPlan {
  id          Int     @id @default(autoincrement())
  marketId    String
  market      Market  @relation(fields: [marketId], references: [id], onDelete: Restrict)
  year        Int
  month       Int
  weekday     Int
  title       String
  link        String
  button      String
  active      Boolean @default(true)
  icon        String?
  rich        Json?
  richHtml    String?
  buttonColor String  @default("green")
  scratch     Boolean @default(false)
  flipCard    Boolean @default(false)

  translations Json?
  category     PromoCategory @default(ALL)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById Int?
  createdBy   AdminUser? @relation("WeeklyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById Int?
  updatedBy   AdminUser? @relation("WeeklyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([marketId, year, month, weekday])
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  // ADMIN može da ima više tržišta (npr. jedan čovek vodi BR i ME); SUPER_ADMIN
  // ih nema — vidi sva.
  markets      Market[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Lozinka: privremena (postavio super admin) mora da se promeni pri prvoj
  // prijavi; sesije izdate pre passwordChangedAt više ne važe.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?

  // 2FA (TOTP): tajna je šifrovana (src/lib/totp.js); rezervni kodovi su
  // sha256 heševi, svaki važi jednom.
  totpSecret        String?
  totpEnabled       Boolean  @default(false)
  totpRecoveryCodes String[] @default([])

  createdSpecials SpecialPromotion[] @relation("SpecialCreatedBy")
  updatedSpecials SpecialPromotion[] @relation("SpecialUpdatedBy")
  createdWeeklies WeeklyPlan[]       @relation("WeeklyCreatedBy")
  updatedWeeklies WeeklyPlan[]       @relation("WeeklyUpdatedBy")
  auditLogs       PromoAuditLog[]
}

// Istorija izmena promocija — jedan red po akciji (kreiranje, izmena, (de)aktivacija,
// brisanje). adminName je snimak imena u trenutku izmene, da log ostane čitljiv
// i kad se nalog kasnije obriše.
model PromoAuditLog {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now())
  marketId  String
  market    Market     @relation(fields: [marketId], references: [id], onDelete: Cascade)
  adminId   Int?
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminName String
  entity    String // "special" | "weekly"
  entityId  Int?
  action    String // "create" | "update" | "activate" | "deactivate" | "delete"
  label     String // npr. "15.10.2026 · Naslov" — čitljivo i posle brisanja
  changes   Json? // { polje: { from, to } }

  @@index([marketId, createdAt])
  @@index([entity, entityId])
}
